{
    "name": "proweb/codeigniter4-news",
    "type": "project",
    "description": "News app on CodeIgniter 4 + UIkit",
    "homepage": "https://github.com/proweb/codeigniter4-news",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "codeigniter4/framework": "^4.7.6"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mikey179/vfsstream": "^1.6",
        "phpunit/phpunit": "^10.5",
        "codeigniter/coding-standard": "^1.9"
    },
    "suggest": {
        "ext-fileinfo": "Improves mime type detection for files"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app",
            "Config\\": "app/Config"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support"
        }
    },
    "scripts": {
        "dev": "php spark serve",
        "test": "phpunit",
        "cs": "php-cs-fixer check --verbose",
        "cs-fix": "php-cs-fixer fix --verbose"
    },
    "support": {
        "issues": "https://github.com/proweb/codeigniter4-news/issues",
        "source": "https://github.com/proweb/codeigniter4-news"
    }
}
